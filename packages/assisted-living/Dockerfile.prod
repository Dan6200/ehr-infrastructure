FROM node:20-alpine AS base

# 1. Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy root lockfiles AND workspace package manifests
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./
COPY packages/assisted-living/package.json ./packages/assisted-living/

RUN \
  if [ -f yarn.lock ]; then yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
  else echo "Lockfile not found." && exit 1; \
  fi

# 2. Rebuild the source code
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build Arguments
ARG NEXT_PUBLIC_FB_API_KEY
ARG NEXT_PUBLIC_FB_AUTH_DOMAIN
ARG NEXT_PUBLIC_FB_PROJECT_ID
ARG NEXT_PUBLIC_FB_STORAGE_BUCKET
ARG NEXT_PUBLIC_FB_APP_ID
ARG NEXT_PUBLIC_FB_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ARG NEXT_PUBLIC_DATABASE_ID
ARG NEXT_PUBLIC_BQ_DATASET_ID

ENV NEXT_PUBLIC_FB_API_KEY=$NEXT_PUBLIC_FB_API_KEY
ENV NEXT_PUBLIC_FB_AUTH_DOMAIN=$NEXT_PUBLIC_FB_AUTH_DOMAIN
ENV NEXT_PUBLIC_FB_PROJECT_ID=$NEXT_PUBLIC_FB_PROJECT_ID
ENV NEXT_PUBLIC_FB_STORAGE_BUCKET=$NEXT_PUBLIC_FB_STORAGE_BUCKET
ENV NEXT_PUBLIC_FB_APP_ID=$NEXT_PUBLIC_FB_APP_ID
ENV NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FB_MESSAGING_SENDER_ID
ENV NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=$NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ENV NEXT_PUBLIC_DATABASE_ID=$NEXT_PUBLIC_DATABASE_ID
ENV NEXT_PUBLIC_BQ_DATASET_ID=$NEXT_PUBLIC_BQ_DATASET_ID

# Target the specific workspace package for build
RUN \
  if [ -f yarn.lock ]; then yarn workspace assisted-living build; \
  elif [ -f package-lock.json ]; then npm run build --workspace=packages/assisted-living; \
  elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm --filter assisted-living build; \
  else echo "Lockfile not found." && exit 1; \
  fi

# 3. Production runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Next.js standalone output mirrors the monorepo directory tree inside standalone/
COPY --from=builder --chown=nextjs:nodejs /app/packages/assisted-living/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/packages/assisted-living/.next/static ./packages/assisted-living/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/packages/assisted-living/public ./packages/assisted-living/public

USER nextjs

EXPOSE 3000

CMD ["node", "packages/assisted-living/server.js"]
